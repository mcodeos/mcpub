.DS_Store
.claude/settings.json
*.pdb
**/mutants.out*/
.trae/

# Generated audit artifacts written by mcc with cwd = repo root
# (render_projection.md / known_missing.md) - never commit
baseline/

# .mcl pack artifacts default to the pack directory (mcc lib pack defaults --out to the pack itself); not committed
*.mcl

# build.sh sweep output (mcc lib pack artifacts per pack, build/mcl/)
# plus the mkregistry.sh static tree (build/registry/) - never commit
/build/
